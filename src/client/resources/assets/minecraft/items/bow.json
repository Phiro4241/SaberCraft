{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "sabercraft:e11",
        "model": {
          "type": "minecraft:model",
          "model": "sabercraft:item/blaster/e11"
        }
      },
      {
        "when": "sabercraft:dl44",
        "model": {
          "type": "minecraft:model",
          "model": "sabercraft:item/blaster/dl44"
        }
      },
      {
        "when": "sabercraft:a280",
        "model": {
          "type": "minecraft:model",
          "model": "sabercraft:item/blaster/a280"
        }
      },
      {
        "when": "sabercraft:repeater",
        "model": {
          "type": "minecraft:model",
          "model": "sabercraft:item/blaster/repeater"
        }
      },
      {
        "when": "sabercraft:rebel",
        "model": {
          "type": "minecraft:model",
          "model": "sabercraft:item/blaster/rebel"
        }
      },
      {
        "when": "sabercraft:ezra",
        "model": {
          "type": "minecraft:model",
          "model": "sabercraft:item/blaster/ezra"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_false": {
        "type": "minecraft:model",
        "model": "minecraft:item/bow"
      },
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:use_duration",
        "scale": 0.05,
        "entries": [
          {
            "threshold": 0.65,
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/bow_pulling_1"
            }
          },
          {
            "threshold": 0.9,
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/bow_pulling_2"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "minecraft:item/bow_pulling_0"
        }
      }
    }
  }
}
