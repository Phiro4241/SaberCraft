{
	"schemaVersion": 1,
	"id": "sabercraft",
	"version": "${version}",
	"name": "SaberCraft",
	"description": "Star Wars for Minecraft: cinematic lightsabers with ignition, glow and sound, blasters that use arrows as ammunition, droid companions, a flyable X-Wing, characters, planets and achievements. All models, textures and sounds are original.",
	"authors": [
		"Phiro"
	],
	"contact": {
		"homepage": "https://github.com/Phiro4241/SaberCraft",
		"sources": "https://github.com/Phiro4241/SaberCraft",
		"issues": "https://github.com/Phiro4241/SaberCraft/issues"
	},
	"license": "All-Rights-Reserved",
	"icon": "assets/sabercraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.phiro.sabercraft.SaberCraft"
		],
		"client": [
			"com.phiro.sabercraft.client.SaberCraftClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"mixins": [
		"sabercraft.mixins.json",
		{
			"config": "sabercraft.client.mixins.json",
			"environment": "client"
		}
	]
}
